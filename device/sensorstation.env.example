# Konfiguration für den systemd-Dienst sensorstation.service.
# Kopieren nach ~/sensor-station/sensorstation.env und anpassen,
# danach: sudo systemctl restart sensorstation

# IP oder Hostname des MQTT-Brokers (leer lassen = MQTT aus)
MQTT_HOST=172.20.10.6

# Port des Brokers (Standard: 1883)
#MQTT_PORT=1883
